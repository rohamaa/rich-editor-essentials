{
    "name": "rohama/rich-editor-essentials",
    "description": "Essential enhancements for the Filament Rich Editor.",
    "keywords": [
        "rohama",
        "laravel",
        "filament",
        "filamentphp",
        "rich-editor"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rohama\\RichEditorEssentials\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "filament/filament": "^5.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rohama\\RichEditorEssentials\\RichEditorEssentialsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}